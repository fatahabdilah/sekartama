# Google Gemini API key for the "Sekar" chat assistant (https://aistudio.google.com/apikey).
# Optional when the key is saved in Admin → Chat AI (needs SUPABASE_SECRET_KEY). Without any key the chat shows a WhatsApp fallback.
GEMINI_API_KEY=
# Optional: override the Gemini model.
GEMINI_MODEL=gemini-2.5-flash

# Supabase (admin panel at /admin). Project Settings → API in the Supabase dashboard.
# Without these the site serves the built-in content from lib/ and /admin is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (Project Settings → API Keys → Secret keys). Lets the chat read the
# Gemini API key saved in the admin panel. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
